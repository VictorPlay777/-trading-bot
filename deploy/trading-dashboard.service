[Unit]
Description=Trading Bot Dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=user1
WorkingDirectory=/home/user1/trading-bot
EnvironmentFile=/home/user1/trading-bot/.env
ExecStart=/home/user1/trading-bot/venv/bin/python -m uvicorn dashboard.backend.app:app --host 127.0.0.1 --port 8080
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
